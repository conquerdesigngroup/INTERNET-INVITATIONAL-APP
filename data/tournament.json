  "moments": [
    {
      "title": "Salim's bogey putt",
      "text": "Salim holed a bogey putt on the last at Payne's Valley to finish Team Big John at +4, one shot clear of Team Micah, and into the final."
    },
    {
      "title": "Horvat's team goes first",
      "text": "Jake Adams bogeyed the second knockout hole while Ryan Whitney holed for par, sending Grant Horvat, Paige Spiranac, Jake Adams and Jon Gruden home."
    },
    {
      "title": "Ruffels out",
      "text": "Captain Ryan Ruffels, the lowest handicap in the field, went out in the semifinal when his trio finished last at +7."
    },
    {
      "title": "Same teams",
      "text": "Bryan's Robby Berger (Bobby Fairways) asked Portnoy to keep the Day 1 teams together for Day 2. Portnoy agreed, and Ruffels won the morning 6–2."
    },
    {
      "title": "Kisner's two shots",
      "text": "Each team got one Kevin Kisner shot. Both used it on the same par 3: Kisner left Bryan's short, then stuck Ruffels' to 12 feet."
    },
    {
      "title": "The $50K hole",
      "text": "The Duke, Team Ruffels' last draft pick, birdied the par-3 9th to win $25K each for himself and Bobby Ray."
    },
    {
      "title": "The clincher",
      "text": "Salim came from 1 down with two to play to beat Kyle Forgeard and take Ruffels to 12½. The last five singles were called in."
    },
    {
      "title": "The twist",
      "text": "Portnoy split Ruffels' 16 into four teams of four under Big John, Horvat, Morris and Ruffels. Four more players go home in Episode 5."
    },
    {
      "title": "The vote",
      "text": "Players voted the pros' group in as captains. Dalke took Tooms first overall; The Duke went last as Team Ruffels' \"Mr. Irrelevant.\""
    },
    {
      "title": "The pick",
      "text": "Ruffels won the captains' closest-to-the-pin after an appeal and a tape measure, earning $5K per teammate and the choice of opponent (Finch)."
    },
    {
      "title": "The Gruden rule",
      "text": "Portnoy let the committee veto any pairing that looked like a thrown match. Ruffels' objection to Bobby Ray/Gruden vs Borrelli/Ellis was denied."
    },
    {
      "title": "The wrong ball",
      "text": "Bobby Ray played a ball that wasn't theirs on 18, turning a Ruffels win into a halve and forcing the 8–8 tie."
    },
    {
      "title": "The Fog Father",
      "text": "Big John holed the putt on the second playoff hole to send Team Ruffels to Day 2."
    },
    {
      "title": "Champions out",
      "text": "2025 winners Brad Dalke and Francis Ellis were both eliminated with their teams."
    }
  ],
